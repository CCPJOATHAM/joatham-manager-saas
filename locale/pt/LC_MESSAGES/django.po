msgid "Mettez a jour l'identite, la devise, la TVA par defaut et les parametres structurants de l'entreprise."
msgstr "Atualize a identidade, a moeda, o IVA padrao e os parametros estruturais da empresa."

msgid "Gerez les comptes gestionnaire et comptable sans quitter votre espace proprietaire."
msgstr "Gerencie contas de gestor e contador sem sair do seu espaco de proprietario."

msgid "Accedez rapidement au portefeuille client et a la relation commerciale."
msgstr "Acesse rapidamente a carteira de clientes e o relacionamento comercial."

msgid "Consultez les sorties financieres et les rapports PDF correspondants."
msgstr "Consulte as saidas financeiras e os relatorios PDF correspondentes."

msgid "Suivez la facturation, les PDF et les paiements dans un espace premium."
